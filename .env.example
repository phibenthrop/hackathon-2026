# Copy to .env and fill in. .env is never committed.
# Without LLM_API_KEY the app uses the deterministic rule-based scorer (full demo works).

# OpenAI-compatible endpoint. Switching provider changes only these three values.
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_MODEL=
LLM_API_KEY=

# Optional
LLM_TIMEOUT_SECONDS=45
PORT=8765
